PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Set this to the public HTTPS origin when deploying, e.g. https://mtaafix.example
APP_ORIGIN=
# Only set when running behind a single trusted reverse proxy.
TRUST_PROXY=
# Mount persistent storage here when deploying.
DATA_DIR=
# Set to false until the location catalog is verified for public use.
ALLOW_REGISTRATION=true
