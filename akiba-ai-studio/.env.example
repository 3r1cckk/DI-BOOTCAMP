# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL where this applet is hosted. Use the local URL during development.
APP_URL="http://localhost:3000"

# Resend password-reset email settings.
# Use a verified sending domain and an address on that domain.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="Akiba <accounts@your-verified-domain.com>"

# Keep the SQLite database on persistent storage when deploying.
AKIBA_DATA_DIR="data"
# Optional full database path. Defaults to data/akiba.sqlite.
# AKIBA_DB_PATH="data/akiba.sqlite"
