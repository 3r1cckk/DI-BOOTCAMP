# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL where this applet is hosted. SMS invitation links require a public
# HTTPS URL that invitees can open; localhost only works on this computer.
APP_URL="http://localhost:3000"

# Resend password-reset and member-invitation email settings.
# Use a verified sending domain and an address on that domain.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="Akiba <accounts@your-verified-domain.com>"

# Sozuri SMS invitations.
SOZURI_API_KEY="your_sozuri_api_key"
SOZURI_PROJECT="your_sozuri_project"
SOZURI_API_URL="https://sozuri.net/api/v1/messaging"
# Optional: set a sender ID approved for your Sozuri project.
# SOZURI_FROM="Akiba"
# SOZURI_TYPE="transactional"

# Keep the SQLite database on persistent storage when deploying.
AKIBA_DATA_DIR="data"
# Optional full database path. Defaults to data/akiba.sqlite.
# AKIBA_DB_PATH="data/akiba.sqlite"
